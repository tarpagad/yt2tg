{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "restartPolicy": "on_failure",
    "startCommand": "python yt2tg.py"
  },
  "env": {
    "TELEGRAM_BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "TELEGRAM_CHANNEL_ID": {
      "description": "Telegram Channel ID",
      "required": true
    },
    "YOUTUBE_CHANNEL_ID": {
      "description": "YouTube Channel ID",
      "required": true
    },
    "DATA_DIR": {
      "description": "Directory for persistent state and downloads (mount volume at this path)",
      "value": "/data"
    }
  }
}
