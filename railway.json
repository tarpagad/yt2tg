{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "restartPolicy": "on_failure",
    "healthcheckPath": "/",
    "healthcheckTimeout": 20,
    "healthcheckInterval": 10,
    "healthcheckTimeoutUnit": "SECONDS",
    "healthcheckIntervalUnit": "SECONDS"
  },
  "env": {
    "TELEGRAM_BOT_TOKEN": {
      "description": "Telegram Bot Token",
      "required": true
    },
    "TELEGRAM_CHANNEL_ID": {
      "description": "Telegram Channel ID",
      "required": true
    },
    "YOUTUBE_CHANNEL_ID": {
      "description": "YouTube Channel ID",
      "required": true
    }
  },
  "cron": {
    "schedule": "0 9 * * *",
    "command": "python yt2tg.py"
  }
}